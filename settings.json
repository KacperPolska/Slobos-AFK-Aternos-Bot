const mineflayer = require('mineflayer')

// --- TWOJE DANE ---
const settings = {
    host: 'SurvivalMareczka.aternos.me', 
    port: 36545,                         
    username: 'Bot_Mareczka',            
    version: '1.21'                      
}

function createBot() {
    const bot = mineflayer.createBot(settings)

    bot.on('login', () => {
        console.log('✅ Połączono! Bot Mareczka wszedł na serwer.')
    })

    bot.on('spawn', () => {
        // Anty-AFK: Bot co 30 sekund podskakuje
        setInterval(() => {
            bot.setControlState('jump', true)
            setTimeout(() => bot.setControlState('jump', false), 500)
        }, 30000)

        // Co minutę pisze na czacie
        setInterval(() => {
            bot.chat('/me pilnuje serwera 24/7')
        }, 60000)
    })

    // Samoczynny powrót po wyrzuceniu
    bot.on('kicked', (reason) => {
        console.log('❌ Wyrzucono bota! Powód:', reason)
        setTimeout(createBot, 10000)
    })

    bot.on('error', (err) => {
        console.log('⚠️ Błąd:', err)
        setTimeout(createBot, 10000)
    })
}

createBot()
